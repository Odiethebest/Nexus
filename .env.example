# RabbitMQ
AMQP_URL=amqp://guest:guest@localhost:5672/

# Redis
REDIS_URL=redis://localhost:6379

# PostgreSQL
POSTGRES_DSN=postgres://nexus:nexus@localhost:5432/nexus?sslmode=disable

# Producer HTTP server
LISTEN_ADDR=:8080
GRPC_ADDR=:50051

# One-click load test (Grafana Cloud k6)
LOADTEST_ENABLED=true
LOADTEST_ADMIN_KEY=replace_me
LOADTEST_COOLDOWN_SECONDS=300
LOADTEST_MIN_START_INTERVAL_SECONDS=10
LOADTEST_MAX_PARALLEL=1
LOADTEST_POLL_INTERVAL_SECONDS=3
LOADTEST_REQUEST_TIMEOUT_SECONDS=20
LOADTEST_UPSTREAM_RETRY_MAX=2
LOADTEST_UPSTREAM_RETRY_BASE_MS=250
LOADTEST_UPSTREAM_RETRY_MAX_MS=2000
LOADTEST_CIRCUIT_BREAKER_THRESHOLD=5
LOADTEST_CIRCUIT_BREAKER_OPEN_SECONDS=30
K6_API_BASE=https://api.k6.io
K6_API_TOKEN=your_k6_api_token_here
K6_STACK_ID=12345
K6_LOAD_TEST_ID=1234
# Optional
LOADTEST_ALLOWED_ORIGINS=
LOADTEST_BUDGET_VUH_PER_DAY=200

# Worker pool sizes
EMAIL_WORKER_POOL=10
INAPP_WORKER_POOL=5
WEBHOOK_WORKER_POOL=8

# SMTP (leave SMTP_HOST empty to disable email sending)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=your_api_key_here
EMAIL_FROM=Nexus <no-reply@example.com>
