# Redpanda (Kafka-protocol) — required
# Comma-separated seed brokers. Local docker-compose exposes 19092.
KAFKA_BROKERS=localhost:19092
KAFKA_CLIENT_ID=nexus
# Partition count per lane topic. Derivation: target_rps / per-partition-rps
# (5–10K msg/s) + ~30% headroom → 12 covers a 50K/s target with room to grow.
KAFKA_TOPIC_PARTITIONS=12
KAFKA_REPLICATION_FACTOR=1
# Redpanda Cloud / managed brokers only — leave empty for docker-compose.
KAFKA_TLS=false
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USER=
KAFKA_SASL_PASS=

# Legacy RabbitMQ — will be removed after Step 7 of MIGRATION.md
AMQP_URL=amqp://guest:guest@localhost:5672/
# Flip to true once KAFKA_BROKERS points at a live Redpanda; false keeps the
# producer/worker on the legacy AMQP path during migration.
USE_KAFKA=false

# Redis
REDIS_URL=redis://localhost:6379

# PostgreSQL
POSTGRES_DSN=postgres://nexus:nexus@localhost:5432/nexus?sslmode=disable

# Producer HTTP server
LISTEN_ADDR=:8080
GRPC_ADDR=:50051

# One-click load test (Grafana Cloud k6)
LOADTEST_ENABLED=false
LOADTEST_ADMIN_KEY=replace_me
LOADTEST_COOLDOWN_SECONDS=300
LOADTEST_MIN_START_INTERVAL_SECONDS=10
LOADTEST_MAX_PARALLEL=1
LOADTEST_POLL_INTERVAL_SECONDS=2
LOADTEST_MAX_RUN_SECONDS=55
LOADTEST_DEMO_RUN_SECONDS=55
LOADTEST_STATUS_TIMEOUT_SECONDS=4
LOADTEST_QUERY_TIMEOUT_SECONDS=3
LOADTEST_REQUEST_TIMEOUT_SECONDS=20
LOADTEST_UPSTREAM_RETRY_MAX=2
LOADTEST_UPSTREAM_RETRY_BASE_MS=250
LOADTEST_UPSTREAM_RETRY_MAX_MS=2000
LOADTEST_CIRCUIT_BREAKER_THRESHOLD=5
LOADTEST_CIRCUIT_BREAKER_OPEN_SECONDS=30
K6_API_BASE=https://api.k6.io
K6_API_TOKEN=your_k6_api_token_here
K6_STACK_ID=12345
K6_LOAD_TEST_ID=1234
# Optional
# If empty, producer defaults to allow all origins (demo-friendly).
# Set a comma-separated explicit allow-list for stricter environments.
# Set to "*" to allow any origin (demo-only).
LOADTEST_ALLOWED_ORIGINS=
LOADTEST_BUDGET_VUH_PER_DAY=0

# Worker pool sizes
EMAIL_WORKER_POOL=10
INAPP_WORKER_POOL=5
WEBHOOK_WORKER_POOL=8

# SMTP (leave SMTP_HOST empty to disable email sending)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=your_api_key_here
EMAIL_FROM="Nexus <no-reply@example.com>"
